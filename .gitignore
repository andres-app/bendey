# TiquePOS - configuración privada por instalación
Config/local.php
.env

# Datos/runtime locales: nunca versionar datos de clientes
storage/*
!storage/.gitkeep

# Conservar carpeta protegida de APISUNAT
!storage/apisunat/
storage/apisunat/*
!storage/apisunat/.htaccess

# Estructura pública de imágenes cargadas por cada instalación
!storage/images/
storage/images/*
!storage/images/.htaccess

!storage/images/company/
storage/images/company/*
!storage/images/company/.gitkeep
!storage/images/company/default_logo.png

!storage/images/products/
storage/images/products/*
!storage/images/products/.gitkeep
!storage/images/products/default.png

!storage/images/users/
storage/images/users/*
!storage/images/users/.gitkeep

# Logs y temporales
Reports/error_log
*.log
*.tmp
*.bak

# Backups y paquetes locales
*.sql.gz
*.backup
attach_backup_*/